# <<< art

LINUX_VT=0
[ "$TERM" = linux ] && LINUX_VT=1

# Find a start script: /usr/local/bin first, then the copy in ~/dotfiles.
find_start() {
    command -v "$1" 2>/dev/null && return
    for f in "$HOME/dotfiles/$1" "$HOME/dotfiles/greetd/greetd/$1"; do
        [ -x "$f" ] && { echo "$f"; return; }
    done
}

restore() {
    # Give the console its palette back, show the cursor, clear the screen.
    [ "$LINUX_VT" = 1 ] && printf '\e]R'
    printf '\e[0m\e[?25h\e[2J\e[H'
}

start() {
    restore
    if [ -n "$SESSION_SEL_DRYRUN" ]; then
        echo "session-sel would run: $*" >&2
        exit 0
    fi
    exec "$@"
}

center() {
    # center <visible width> <text with escapes>
    local pad=$(( (COLS - $1) / 2 ))
    (( pad < 0 )) && pad=0
    printf '%*s' "$pad" ''
    printf '%b\n' "$2"
}

draw() {
    resized=0
    read -r ROWS COLS < <(stty size </dev/tty 2>/dev/null || echo "24 80")
    local accent dim='\e[0;37m' bold='\e[0;1;37m' reset='\e[0m'
    if [ "$LINUX_VT" = 1 ]; then
        printf '%b' "$ART_PALETTE"
        accent="$ACCENT_LINUX"
    else
        accent="$ACCENT_TRUE"
        dim='\e[0;38;2;150;150;150m'
    fi
    # The banner is the title: use the biggest variant that fits with the
    # text below it; without room for any, fall back to a plain title line.
    local -a art=()
    local art_w=0 i
    for i in "${!ART_W[@]}"; do
        if (( ROWS >= ART_H[i] + 7 && COLS >= ART_W[i] )); then
            if [ "$LINUX_VT" = 1 ]; then local -n variant="ART_LINUX_$i"; else local -n variant="ART_TRUE_$i"; fi
            art=("${variant[@]}")
            art_w=${ART_W[i]}
            break
        fi
    done
    local title="Chao Phraya WM"
    local sub="based on river wayland compositor"
    local l1="press [enter] to enter Chao Phraya WM"
    local l2="press [s] to fall back to sway"
    local l3="press [\$] to enter sh"
    # A picture gets the title underneath; a title banner doesn't need it.
    local show_title=1
    (( ${#art[@]} > 0 && ${ART_IS_TITLE:-0} == 1 )) && show_title=0
    local total=$(( ${#art[@]} + 6 + show_title ))
    local top=$(( (ROWS - total) / 2 ))
    (( top < 0 )) && top=0

    printf '\e[?25l\e[3J\e[2J\e[H'
    printf '%*s' "$top" '' | tr ' ' '\n'
    local line
    for line in "${art[@]}"; do
        center "$art_w" "$line"
    done
    if (( show_title )); then
        (( ${#art[@]} > 0 )) && echo
        center ${#title} "${bold}${title}${reset}"
    fi
    echo
    center ${#sub} "${dim}${sub}${reset}"
    echo
    center ${#l1} "${dim}press ${accent}[enter]${dim} to enter ${bold}Chao Phraya WM${reset}"
    center ${#l2} "${dim}press ${accent}[s]${dim} to fall back to sway${reset}"
    center ${#l3} "${dim}press ${accent}[\$]${dim} to enter sh${reset}"
}

trap restore EXIT
# Only flag resizes; redrawing inside the trap would interleave with a draw
# that is still running.
resized=1
trap 'resized=1' WINCH
while true; do
    while (( resized )); do draw; done
    IFS= read -rsn1 key </dev/tty
    rc=$?
    # >128: interrupted by a signal (a resize): redraw and wait again.
    (( rc > 128 )) && continue
    (( rc != 0 )) && exit 1
    case "$key" in
        "") start "$(find_start start-chaophraya || echo start-chaophraya)" ;;
        s | S) start "$(find_start start-sway || echo start-sway)" ;;
        '$') start sh ;;
    esac
done
